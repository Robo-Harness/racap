# Copy this file to configs/local.env and fill one model route.

# Route A: OpenRouter directly through RATs.
# export OPENROUTER_API_KEY="..."
# export RACAP_MODEL="openrouter/gpt-5.5"
# export RACAP_GROUNDER_MODEL="openrouter/gpt-5.5"
# export RACAP_VERIFIER_MODEL="openrouter/gpt-5.5"

# Route B: an OpenAI-compatible VAPI relay. Models without the openrouter/
# prefix are sent through RACAP_VAPI_BASE by racap.backends.llm.
# export RACAP_VAPI_KEY="..."
# export RACAP_VAPI_BASE="https://your-relay.example/v1"
# export RACAP_MODEL="gpt-5.5"
# export RACAP_GROUNDER_MODEL="gpt-5.5"
# export RACAP_VERIFIER_MODEL="gpt-5.5"
# Evolution roles also use this VAPI route when their IDs have no
# openrouter/ prefix. They are independent from the runtime ReAct model.
# export RACAP_CODER_MODEL="gpt-5.6"
# export RACAP_CRITIC_MODEL="gpt-5.5"

# Optional hardware and endpoint overrides.
# export RACAP_GPU="0"
# export CUDA_VISIBLE_DEVICES="0"
# export RACAP_SAM3_URL="http://127.0.0.1:8114"
# export RACAP_GRASPNET_URL="http://127.0.0.1:8115"
# export RACAP_PYROKI_URL="http://127.0.0.1:8116"
